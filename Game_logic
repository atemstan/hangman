#ifndef GAME_LOGIC_H
#define GAME_LOGIC_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <time.h>

#define MAX_WORDS 100
#define MAX_WORD_LEN 50
#define MAX_LIVES 6

typedef enum {
    PLAYING,
    WON,
    LOST
} GameStatus;

typedef struct {
    char words[MAX_WORDS][MAX_WORD_LEN];
    int word_count;
    char secret_word[MAX_WORD_LEN];
    char guessed_letters[26];
    int guessed_count;
    char wrong_guesses[26];
    int wrong_count;
    int lives;
    GameStatus status;
} HangmanGame;

void doc_danh_sach_tu_tu_file(HangmanGame *game, const char *ten_file) {
    FILE *file = fopen(ten_file, "r");
    if (file == NULL) {
        strcpy((*game).words[0], "programming");
        (*game).word_count = 1;
        return;
    }

    (*game).word_count = 0;
    char buffer[MAX_WORD_LEN];
    
    while (fgets(buffer, sizeof(buffer), file) != NULL && (*game).word_count < MAX_WORDS) {
        buffer[strcspn(buffer, "\r\n")] = '\0';
        
        if (strlen(buffer) > 0) {
            for (int j = 0; buffer[j] != '\0'; j++) {
                buffer[j] = tolower(buffer[j]);
            }
            strcpy((*game).words[(*game).word_count], buffer);
            (*game).word_count++;
        }
    }
    
    fclose(file);

    if ((*game).word_count <= 0) {
        strcpy((*game).words[0], "python");
        (*game).word_count = 1;
    }
}

void bat_dau_van_moi(HangmanGame *game) {
    int index;
    char tu_cu[MAX_WORD_LEN];
    strcpy(tu_cu, (*game).secret_word);

    if ((*game).word_count <= 1) {
        index = 0;
    } else {
        do {
            index = rand() % (*game).word_count;
        } while (strcmp((*game).words[index], tu_cu) == 0);
    }

    strcpy((*game).secret_word, (*game).words[index]);

    (*game).lives = MAX_LIVES;
    (*game).guessed_count = 0;
    (*game).wrong_count = 0;
    (*game).status = PLAYING;
    
    memset((*game).guessed_letters, 0, sizeof((*game).guessed_letters));
    memset((*game).wrong_guesses, 0, sizeof((*game).wrong_guesses));
}

int kiem_tra_thang(const HangmanGame *game) {
    int len = strlen((*game).secret_word);
    for (int i = 0; i < len; i++) {
        char c = (*game).secret_word[i];
        if (c != ' ') {
            int tim_thay = 0;
            for (int j = 0; j < (*game).guessed_count; j++) {
                if ((*game).guessed_letters[j] == c) {
                    tim_thay = 1;
                    break;
                }
            }
            if (!tim_thay) return 0;
        }
    }
    return 1;
}

int xu_ly_doan_chu(HangmanGame *game, char letter) {
    if ((*game).status != PLAYING) return 0;

    letter = tolower(letter);
    if (!isalpha(letter)) return 0;

    for (int i = 0; i < (*game).guessed_count; i++) {
        if ((*game).guessed_letters[i] == letter) return 0;
    }
    for (int i = 0; i < (*game).wrong_count; i++) {
        if ((*game).wrong_guesses[i] == letter) return 0;
    }

    int co_trong_tu = 0;
    int len = strlen((*game).secret_word);
    for (int i = 0; i < len; i++) {
        if ((*game).secret_word[i] == letter) {
            co_trong_tu = 1;
            break;
        }
    }

    if (co_trong_tu) {
        (*game).guessed_letters[(*game).guessed_count] = letter;
        (*game).guessed_count++;

        if (kiem_tra_thang(game)) {
            (*game).status = WON;
        }
    } else {
        (*game).wrong_guesses[(*game).wrong_count] = letter;
        (*game).wrong_count++;
        (*game).lives--;

        if ((*game).lives <= 0) {
            (*game).status = LOST;
        }
    }

    return 1;
}

#endif
